PORT=8787
# Gemini is tried first when GEMINI_API_KEY is set; local Ollama and offline are fallbacks.
# 'offline' always works and should stay last.
AI_PROVIDERS=gemini,ollama,offline
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=aya-expanse:8b
# Optional cloud providers. Gemini uses GEMINI_API_KEY; Groq uses GROQ_API_KEY.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Optional Addis AI speech services. Never put this key in frontend code.
ADDIS_API_KEY=
AI_TIMEOUT_MS=8000
# Minimum share of the question's terms that must match course content
MIN_COVERAGE=0.3
# '*' for the demo, or a comma-separated list of partner sites, e.g.
# CORS_ORIGIN=https://inclusive.example,https://partner.example
CORS_ORIGIN=*
RATE_LIMIT_PER_MIN=30

# Human help: the support person signs in to /agent with this key. Leave empty to disable.
# Make one:  node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
AGENT_KEY=
HANDOFF_RATE_LIMIT_PER_MIN=5

# Telegram bot (separate process, started with: npm run bot)
TELEGRAM_BOT_TOKEN=
API_URL=http://localhost:8787
# Shared secret so the bot's server-to-server calls skip the per-IP rate
# limit (many learners share the bot's one IP address). Optional but
# recommended for the live demo. Make one the same way as AGENT_KEY.
INTERNAL_KEY=

# Low-bandwidth SMS/text route. Runs inside the main server (no extra process).
# Defaults to a console simulator so you can test without a real gateway.
# Leave SMS_INBOUND_KEY empty to disable the route entirely.
# Once a real gateway is chosen at kick-off: set SMS_PROVIDER=webhook, fill in
# SMS_WEBHOOK_URL/SMS_WEBHOOK_KEY, and adjust api/sms/webhook-adapter.js to
# match that gateway's exact request shape (most gateways differ from ours).
SMS_PROVIDER=console
SMS_INBOUND_KEY=
SMS_WEBHOOK_URL=
SMS_WEBHOOK_KEY=