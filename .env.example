PORT=8787
# Gemini and Groq are cloud providers; local Ollama is for local development.
# 'offline' always works and should stay last.
AI_PROVIDERS=gemini,groq,ollama,offline
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=aya-expanse:8b
# Optional cloud providers. Gemini uses GEMINI_API_KEY; Groq uses GROQ_API_KEY.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Optional Addis AI speech services. Never put this key in frontend code.
ADDIS_API_KEY=
AI_TIMEOUT_MS=8000
# Minimum share of the question's terms that must match course content
MIN_COVERAGE=0.3
# '*' for the demo, or a comma-separated list of partner sites, e.g.
# CORS_ORIGIN=https://inclusive.example,https://partner.example
CORS_ORIGIN=*
RATE_LIMIT_PER_MIN=30

# Human help: the support person signs in to /agent with this key. Leave empty to disable.
# Make one:  node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
AGENT_KEY=
HANDOFF_RATE_LIMIT_PER_MIN=5

# Telegram bot. Render uses the API server webhook; local polling is optional.
TELEGRAM_BOT_TOKEN=
API_URL=http://localhost:8787
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_PATH=/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=
# Set true only when running npm run bot locally with its webhook removed.
TELEGRAM_POLLING=false
# Shared secret so the bot's server-to-server calls skip the per-IP rate
# limit (many learners share the bot's one IP address). Optional but
# recommended for the live demo. Make one the same way as AGENT_KEY.
INTERNAL_KEY=

# Low-bandwidth SMS/text route. The console simulator needs no external gateway.
SMS_PROVIDER=console
SMS_INBOUND_KEY=
SMS_WEBHOOK_URL=
SMS_WEBHOOK_KEY=
# Telerivet production integration. Configure all required values in Render.
# Set SMS_PROVIDER=telerivet and use a Render Redis service for durable webhook
# deduplication and queueing. Never put real keys in this example file.
TELERIVET_API_KEY=
TELERIVET_PROJECT_ID=
# Optional when the project has multiple sending routes.
TELERIVET_ROUTE_ID=
# Use the same randomly generated value (at least 16 non-whitespace characters)
# in the Telerivet webhook service.
TELERIVET_WEBHOOK_SECRET=
REDIS_URL=